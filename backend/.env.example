# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# postgresql (mặc định, dùng cho dev/prod) | sqlite (chạy nhanh không cần cài PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=ats_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS: origin của frontend (Vite chạy ở cổng 3000) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Nghiệp vụ ---
# True: công ty phải được admin xác minh (Django Admin) mới được đăng tin
EMPLOYER_REQUIRE_VERIFIED_COMPANY=False

# --- AI (giai đoạn sau, hiện chưa dùng) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
