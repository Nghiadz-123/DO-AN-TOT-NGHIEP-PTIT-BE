# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# PostgreSQL (>= 13). Tạo trước database: CREATE DATABASE ats_db;
DB_NAME=CV_suggestion_system
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432
# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS: origin của frontend (Vite chạy ở cổng 3000) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Nghiệp vụ ---
# True: công ty phải được admin xác minh (Django Admin) mới được đăng tin
EMPLOYER_REQUIRE_VERIFIED_COMPANY=False
# Số CV tối đa mỗi ứng viên được lưu
CANDIDATE_MAX_CVS=10

# --- AI (apps.ai: chấm điểm CV, gợi ý sửa CV, gợi ý việc làm) — cùng cấu hình với prototype TestAI ---
LLM_PROVIDER=gemini
# Key Gemini (miễn phí tại https://aistudio.google.com): điền key thật vào .env, KHÔNG ghi vào file này
GEMINI_API_KEY=
# Nhiều model cách nhau dấu phẩy: model đầu quá tải / hết quota thì tự chuyển sang model sau
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Thời gian chờ tối đa (giây) cho mỗi lần gọi Gemini
AI_REQUEST_TIMEOUT=60
